# Server configuration
PORT=3000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info

# Databases
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/netstream
REDIS_URL=redis://localhost:6379

# Auth secrets
JWT_SECRET=dev_jwt_secret_must_be_at_least_32_characters_long_for_security
COOKIE_SECRET=dev_cookie_secret_must_be_at_least_32_characters_long_for_security

# WebRTC & Media
PUBLIC_IP=127.0.0.1
RTC_MIN_PORT=40000
RTC_MAX_PORT=40100
MEDIA_WORKERS=
TURN_HOST=localhost
TURN_SECRET=dev_turn_secret_for_coturn

# HLS & VOD
HLS_ENABLED=true
HLS_DIR=./media/hls
VOD_DIR=./media/vod
